{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "kubectl apply*": "deny",
      "kubectl delete*": "deny",
      "kubectl patch*": "deny",
      "kubectl replace*": "deny",
      "kubectl create*": "deny",
      "kubectl edit*": "deny",
      "kubectl scale*": "deny",
      "kubectl rollout restart*": "deny",
      "kubectl rollout undo*": "deny",
      "git push *main*": "deny",
      "git push origin main*": "deny"
    }
  }
}
